---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags?: string[];
  timeframe?: string;
  commit_count?: number;
  status?: string;
}

const { title, date, description, tags, timeframe, commit_count, status } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — Tejas Nafde`} description={description}>
  <article class="post">
    <header class="post-header">
      {status === 'draft' && <span class="draft-badge">draft</span>}
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date}>{formattedDate}</time>
        {timeframe && <span class="meta-sep">/</span>}
        {timeframe && <span>{timeframe}</span>}
        {commit_count && <span class="meta-sep">/</span>}
        {commit_count && <span>{commit_count} commits</span>}
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="post-content">
      <slot />
    </div>
    <footer class="post-footer">
      <a href="/blog">&larr; back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 8rem 2rem 2rem;
  }

  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .draft-badge {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border: 1px solid #c9a84c;
    color: #c9a84c;
    margin-bottom: 1rem;
  }

  .post-header h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 2.2rem;
    line-height: 1.2;
    color: var(--text-bright);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .post-meta {
    color: var(--text-dim);
    font-size: 0.8rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    letter-spacing: 0.02em;
  }

  .meta-sep {
    opacity: 0.4;
  }

  .post-tags {
    display: flex;
    gap: 0.3rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.65rem;
    letter-spacing: 0.03em;
    color: var(--text-dim);
    background: rgba(201, 168, 76, 0.15);
    padding: 0.15rem 0.45rem;
  }

  .post-content {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--text);
  }

  .post-content :global(h2) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.5rem;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--text-bright);
  }

  .post-content :global(h3) {
    font-size: 1.1rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-bright);
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(code) {
    font-family: var(--font-body);
    font-size: 0.88em;
    background: var(--bg-elevated);
    padding: 0.15em 0.4em;
    border: 1px solid var(--border);
  }

  .post-content :global(pre) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    border: none;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: 1.25rem;
    color: var(--text-dim);
    margin: 1.5rem 0;
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .post-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-footer a {
    color: var(--text-dim);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
  }

  .post-footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .post {
      padding: 6rem 1.25rem 2rem;
    }

    .post-header h1 {
      font-size: 1.6rem;
    }
  }
</style>
