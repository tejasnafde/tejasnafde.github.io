---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags?: string[];
  timeframe?: string;
  commit_count?: number;
  status?: string;
}

const { title, date, description, tags, timeframe, commit_count, status } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} - Tejas Nafde`} description={description}>
  <article class="post">
    <header class="post-header">
      {status === 'draft' && <span class="draft-badge label">draft</span>}
      <h1>{title}</h1>
      <div class="post-meta label num">
        <time datetime={date}>{formattedDate}</time>
        {timeframe && <span class="meta-sep">/</span>}
        {timeframe && <span>{timeframe}</span>}
        {commit_count && <span class="meta-sep">/</span>}
        {commit_count && <span>{commit_count} commits</span>}
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <span class="tag label">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="post-content">
      <slot />
    </div>
    <footer class="post-footer">
      <a href="/blog" class="label">&larr; back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: calc(var(--sp-8) + var(--sp-6)) var(--sp-6) var(--sp-5);
  }

  .post-header {
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--line);
  }

  .draft-badge {
    display: inline-block;
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    color: var(--accent);
    padding: 1px var(--sp-2);
    margin-bottom: var(--sp-3);
  }

  .post-header h1 {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--sp-3);
  }

  .post-meta {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    flex-wrap: wrap;
  }

  .meta-sep {
    opacity: 0.4;
  }

  .post-tags {
    display: flex;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
    flex-wrap: wrap;
  }

  .tag {
    background: var(--accent-subtle);
    color: var(--ink-2);
    padding: 1px var(--sp-2);
    border-radius: var(--r-sm);
  }

  .post-content {
    font-size: var(--text-md);
    line-height: 1.75;
    color: var(--ink-2);
  }

  .post-content :global(h2) {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink);
    margin-top: var(--sp-7);
    margin-bottom: var(--sp-3);
  }

  .post-content :global(h3) {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--ink);
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-2);
  }

  .post-content :global(p) {
    margin-bottom: var(--sp-4);
    max-width: none;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  .post-content :global(pre) {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: var(--sp-4) var(--sp-5);
    overflow-x: auto;
    margin-bottom: var(--sp-4);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    border: none;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: var(--sp-4);
    padding-left: var(--sp-5);
  }

  .post-content :global(li) {
    margin-bottom: var(--sp-1);
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: var(--sp-4);
    color: var(--ink-3);
    margin: var(--sp-4) 0;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: var(--sp-6) 0;
  }

  .post-footer {
    margin-top: var(--sp-7);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .post-footer a {
    color: var(--ink-2);
  }

  .post-footer a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .post {
      padding: calc(var(--sp-8) + var(--sp-4)) var(--sp-4) var(--sp-5);
    }
  }
</style>
