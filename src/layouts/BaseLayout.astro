---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Tejas Nafde - Software Engineer' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-logo">tejas nafde</a>
        <div class="nav-links">
          <a href="/#work">work</a>
          <a href="/#projects">projects</a>
          <a href="/blog">writing</a>
          <a href="https://drive.google.com/file/d/1sYJAv4TOsi_pFA71pgHXbWaDUbcmbjKA/view?usp=sharing" target="_blank" rel="noopener">resume</a>
          <a href="mailto:nafdetejas@gmail.com" class="nav-contact">get in touch</a>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <span class="footer-left">&copy; {new Date().getFullYear()}</span>
        <div class="footer-links">
          <a href="https://github.com/tejasnafde" target="_blank" rel="noopener">github</a>
          <a href="https://www.linkedin.com/in/tejas-nafde/" target="_blank" rel="noopener">linkedin</a>
          <a href="mailto:nafdetejas@gmail.com">email</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(10, 10, 9, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--text-bright);
    letter-spacing: -0.01em;
  }

  .nav-logo:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-links a {
    color: var(--text-dim);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    transition: color 0.15s;
  }

  .nav-links a:hover {
    color: var(--text-bright);
  }

  .nav-contact {
    color: var(--accent) !important;
    border: 1px solid var(--border-bright);
    padding: 0.35rem 0.9rem;
  }

  .nav-contact:hover {
    border-color: var(--accent) !important;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem;
    margin-top: 6rem;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-left {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .footer-links a:hover {
    color: var(--text-bright);
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding: 0.8rem 1.25rem;
    }

    .nav-links {
      gap: 1rem;
    }

    .nav-links a {
      font-size: 0.75rem;
    }

    .nav-contact {
      display: none;
    }

    .footer-inner {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
