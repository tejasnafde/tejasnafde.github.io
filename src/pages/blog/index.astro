---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const isDev = import.meta.env.DEV;

const posts = (await getCollection('blog', ({ data }) => {
  return isDev || data.status === 'published';
})).sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Writing - Tejas Nafde" description="Engineering notes and technical writing by Tejas Nafde">
  <section class="blog-page">
    <div class="blog-inner">
      <h1>Writing</h1>
      <p class="blog-desc">Engineering notes, technical deep-dives, and things I've learned building software.</p>

      {posts.length === 0 ? (
        <p class="empty">Nothing published yet. Check back soon.</p>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-row">
              <div class="post-info">
                <div class="post-title-row">
                  {post.data.status === 'draft' && <span class="draft-badge label">draft</span>}
                  <h2>{post.data.title}</h2>
                </div>
                {post.data.description && <p class="post-desc">{post.data.description}</p>}
                <div class="post-meta label num">
                  <time datetime={post.data.date}>
                    {new Date(post.data.date).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  {post.data.timeframe && <span class="sep">/</span>}
                  {post.data.timeframe && <span>{post.data.timeframe}</span>}
                  {post.data.commit_count && <span class="sep">/</span>}
                  {post.data.commit_count && <span>{post.data.commit_count} commits</span>}
                </div>
              </div>
              {post.data.tags && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag label">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page {
    padding: calc(var(--sp-8) + var(--sp-6)) var(--sp-6) var(--sp-5);
  }

  .blog-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--sp-2);
  }

  .blog-desc {
    color: var(--ink-2);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-6);
  }

  .empty {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-5);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
  }

  .post-row:first-child {
    border-top: 1px solid var(--line);
  }

  .post-row:hover {
    text-decoration: none;
  }

  .post-info {
    flex: 1;
  }

  .post-title-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }

  .draft-badge {
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    color: var(--accent);
    padding: 1px var(--sp-2);
    flex-shrink: 0;
  }

  .post-title-row h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    transition: color var(--dur-1) var(--ease);
  }

  .post-row:hover h2 {
    color: var(--accent);
  }

  .post-desc {
    color: var(--ink-2);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-1);
  }

  .post-meta {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    flex-wrap: wrap;
  }

  .sep {
    opacity: 0.4;
  }

  .post-tags {
    display: flex;
    gap: var(--sp-1);
    flex-wrap: wrap;
    flex-shrink: 0;
    align-self: center;
  }

  .tag {
    background: var(--accent-subtle);
    color: var(--ink-2);
    padding: 1px var(--sp-2);
    border-radius: var(--r-sm);
  }
</style>
