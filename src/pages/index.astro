---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const experience = [
  {
    role: 'Software Development Engineer',
    company: 'GeoIQ',
    companyNote: 'a Lenskart company',
    url: 'https://geoiq.io',
    period: 'Jun 2025 - Present',
    highlights: [
      'Own an end-to-end automated pipeline that transforms survey data into client-specific presentations, generating each in 30s-5min.',
      'Designed a decorator-based caching layer with conditional invalidation, reducing API latency by 80% for cached sections.',
      'Built a standalone payment and invoicing service with idempotent verification and webhook-driven state management.',
      'Architected a real-time messaging platform used across three production applications using WebSockets and Pub/Sub.',
      'Integrated telephony with automated call summaries, shared broker notes, and webhook-driven state tracking.',
    ],
  },
  {
    role: 'Software Development Engineer Intern',
    company: 'GeoIQ',
    companyNote: 'a Lenskart company',
    url: 'https://geoiq.io',
    period: 'Jan - Jun 2025',
    highlights: [
      'Built a FastAPI WebSocket gateway with room-based messaging and centralized connection lifecycle management.',
      'Developed Slack-based admin tooling with approval workflows for safe GCP Compute Engine operations.',
      'Designed a feature-flagged multi-channel notification system (push, WhatsApp, email) with delivery-state tracking.',
    ],
  },
];

// The live directory. This is the catalog that ring.js points at ("All N"
// lands on #tools), so it must track APPS in public/ring.js: same sites, same
// cat values (play / tools / read). Every entry here is deployed and the whole
// row is a link to it.
const liveSites = [
  { cat: 'fun', name: 'Follymarket', host: 'follymarket.tn07.dev', icon: '/icons/follymarket.svg', blurb: 'Play-money prediction markets. Make a market, trade a position, see who called it.' },
  { cat: 'fun', name: 'Board Games', host: 'gaming.tn07.dev', icon: '/icons/gaming.svg', blurb: 'Battleship, Connect 4 and Labyrinth in the browser, no physical set needed.' },
  { cat: 'fun', name: 'Marvel Syllabus', host: 'marvel.tn07.dev', icon: '/icons/marvel.svg', blurb: 'A continuity-ordered reading syllabus for 65 years of Marvel comics.' },
  { cat: 'tools', name: 'WatchWithMi', host: 'watchwithmi.tn07.dev', icon: '/icons/watchwithmi.svg', blurb: 'Watch things together, in sync. Rooms, chat, and a shared player.' },
  { cat: 'tools', name: 'Someday', host: 'someday.tn07.dev', icon: '/icons/someday.png', blurb: 'Shared memory for friendships. The things you said you would get around to.' },
  { cat: 'tools', name: 'Scout', host: 'scout.tn07.dev', icon: '/icons/scout.svg', blurb: 'Remote jobs, scored against your profile.' },
];

// Code-only projects. The live sites live in liveSites above; this list is
// only things whose home is a repo. Cut deliberately: no abandoned work, no
// OSS contributions to other people's projects.
const projects = [
  {
    name: 'Switchboard',
    icon: '/icons/switchboard.png',
    description: 'Agent workspace. Reaches work VMs over IAP WebSocket tunnels, so it needs no VPN and no routable SSH port.',
    tech: ['TypeScript', 'Electron', 'GCP IAP'],
    link: 'https://github.com/tejasnafde/switchboard',
  },
  {
    name: 'macremote',
    icon: '/icons/macremote.png',
    description: 'Your Mac, in your pocket. A FastAPI control server paired with a Hammerspoon bridge and a browser extension.',
    tech: ['Python', 'FastAPI', 'Hammerspoon'],
    link: 'https://github.com/tejasnafde/macremote',
  },
  {
    name: 'FZM Server Manager',
    description: 'Production bot for Factorio multiplayer servers. WebSocket real-time updates, REST lifecycle control, dual-layer state persistence.',
    tech: ['Python', 'WebSockets', 'SQLite', 'Docker'],
    link: 'https://github.com/tejasnafde/fzm-discord-bot',
  },
  {
    name: 'bbpr',
    description: 'Fetches Bitbucket Cloud pull requests in a shape AI agents can review. Install once, point any agent at a PR.',
    tech: ['Python', 'Bitbucket API'],
    link: 'https://github.com/tejasnafde/bbpr',
  },
  {
    name: 'tejas-skills',
    description: 'Personal skill library for AI coding agents. One format that works across Claude Code, Cursor, and friends.',
    tech: ['Markdown', 'Agent Skills'],
    link: 'https://github.com/tejasnafde/tejas-skills',
  },
  {
    name: 'learnlang',
    description: 'A voice tutor for one user. Talk to it in the language you are learning, it talks back, and it remembers what you got wrong.',
    tech: ['Python', 'Vertex AI', 'Speech'],
    link: 'https://github.com/tejasnafde/learnlang',
  },
  {
    name: 'Unetsim-Routing',
    description: 'Multi-layered underwater sensor network and routing protocol built on UnetStack.',
    note: 'Research project under Prof. Sarang C. Dhongdi, BITS Pilani Goa',
    tech: ['Java', 'Groovy', 'UnetStack'],
    link: 'https://github.com/tejasnafde/Unetsim-Routing',
  },
  {
    name: 'MyOptum',
    description: 'Hardware communication layer for a remote phoropter. Real-time serial comms with a custom binary protocol (SOH/CR/EOT).',
    note: 'Lenskart Hackathon - Special Mention',
    tech: ['Python', 'Serial Protocol'],
    link: null,
    status: 'private',
  },
];

const stack = [
  { group: 'Languages', items: ['Python', 'TypeScript', 'SQL'] },
  { group: 'Backend', items: ['FastAPI', 'Flask', 'WebSockets', 'Socket.IO'] },
  { group: 'Frontend', items: ['React', 'Next.js', 'Electron'] },
  { group: 'Data', items: ['MongoDB', 'PostgreSQL', 'SQLite', 'Redis'] },
  { group: 'Infra', items: ['GCP', 'Docker', 'Fly.io', 'Linux'] },
  { group: 'APIs', items: ['Razorpay', 'Zoho', 'Slack API', 'LLM APIs'] },
];

const catLabels = { fun: 'Fun', tools: 'Tools' };
const cats = ['fun', 'tools'];
---

<BaseLayout title="Tejas Nafde - Software Engineer">
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-label label">Software Engineer / Bengaluru</div>
      <h1 class="hero-name">Tejas Nafde</h1>
      <div class="hero-lower">
        <p class="hero-desc">
          I build backend systems, real-time infrastructure, and developer tools.
          Currently engineering at <a href="https://geoiq.io" target="_blank" rel="noopener">GeoIQ</a>.
          BITS Pilani, Goa alumnus.
        </p>
        <div class="hero-links">
          <a href="https://github.com/tejasnafde" target="_blank" rel="noopener">github</a>
          <a href="https://www.linkedin.com/in/tejas-nafde/" target="_blank" rel="noopener">linkedin</a>
          <a href="mailto:nafdetejas@gmail.com">email</a>
          <a href="https://drive.google.com/file/d/1sYJAv4TOsi_pFA71pgHXbWaDUbcmbjKA/view?usp=sharing" target="_blank" rel="noopener">resume</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects: the live directory (which ring.js lands on via #tools) plus
       code-only work, one section. -->
  <section id="projects" class="section">
    <div class="wrap">
      <span id="tools" class="anchor" aria-hidden="true"></span>
      <div class="section-head">
        <h2>Projects</h2>
        <p class="section-lede">The live ones you can just go use. Everything else is on GitHub.</p>
      </div>
      <div class="dir">
        {cats.map((cat) => (
          <Fragment>
            {liveSites.filter((s) => s.cat === cat).map((s, i) => s.soon ? (
              <div class="dir-row dir-row--soon">
                <span class="dir-cat label">{i === 0 ? catLabels[cat] : ''}</span>
                <img class="dir-icon" src={s.icon} alt="" width="28" height="28" loading="lazy" />
                <span class="dir-main">
                  <b class="dir-name">{s.name}</b>
                  <span class="dir-blurb">{s.blurb}</span>
                </span>
                <span class="dir-host">soon</span>
                <span class="dir-chev" aria-hidden="true"></span>
              </div>
            ) : (
              <a href={`https://${s.host}`} class="dir-row">
                <span class="dir-cat label">{i === 0 ? catLabels[cat] : ''}</span>
                <img class="dir-icon" src={s.icon} alt="" width="28" height="28" loading="lazy" />
                <span class="dir-main">
                  <b class="dir-name">{s.name}</b>
                  <span class="dir-blurb">{s.blurb}</span>
                </span>
                <span class="dir-host">{s.host}</span>
                <span class="dir-chev" aria-hidden="true">&rsaquo;</span>
              </a>
            ))}
          </Fragment>
        ))}
      </div>
      <div class="card-grid">
        {projects.map((p) => (
          <div class={`card ${p.link ? '' : 'card--flat'}`}>
            <div class="card-top">
              {p.icon && <img class="card-icon" src={p.icon} alt="" width="22" height="22" loading="lazy" />}
              {p.link ? (
                <a href={p.link} target="_blank" rel="noopener" class="card-name">{p.name}</a>
              ) : (
                <span class="card-name">{p.name}</span>
              )}
              {p.link && <span class="card-gh label">github &rsaquo;</span>}
              {p.status && <span class={`badge label badge--${p.status}`}>{p.status}</span>}
            </div>
            <p class="card-desc">{p.description}</p>
            {p.note && <p class="card-note">{p.note}</p>}
            <div class="tags">
              {p.tech.map((t) => (
                <span class="tag label">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="work" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
      </div>
      <div class="exp-list">
        {experience.map((job, i) => (
          <div class={`exp-block ${i > 0 ? 'exp-block--later' : ''}`}>
            <div class="exp-top">
              <div>
                <span class="exp-role">{job.role}</span>
                <a href={job.url} target="_blank" rel="noopener" class="exp-company">
                  {job.company} <span class="exp-note">({job.companyNote})</span>
                </a>
              </div>
              <span class="exp-period label num">{job.period}</span>
            </div>
            <ul class="exp-bullets">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="section section--compact">
    <div class="wrap">
      <div class="section-head">
        <h2>Tools &amp; Stack</h2>
      </div>
      <div class="stack">
        {stack.map((row) => (
          <div class="stack-row">
            <span class="stack-cat label">{row.group}</span>
            <span class="stack-items">
              {row.items.map((it, i) => (
                <Fragment>
                  <span class="stack-item">{it}</span>
                  {i < row.items.length - 1 && <span class="skill-sep" aria-hidden="true">/</span>}
                </Fragment>
              ))}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Posts -->
  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Writing</h2>
        </div>
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-row">
              <span class="post-title">{post.data.title}</span>
              <span class="post-line"></span>
              <time class="label num" datetime={post.data.date}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
            </a>
          ))}
        </div>
        <a href="/blog" class="link-subtle label">all posts &rarr;</a>
      </div>
    </section>
  )}

  <!-- Contact -->
  <section class="section section--contact">
    <div class="wrap">
      <h2 class="contact-title">Let's talk.</h2>
      <p class="contact-desc">Open to interesting conversations about engineering, side projects, or new opportunities.</p>
      <a href="mailto:nafdetejas@gmail.com" class="contact-link">nafdetejas@gmail.com &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  /* ---- Hero ---- */
  .hero {
    padding: calc(var(--sp-8) + var(--sp-7)) 0 var(--sp-7);
    border-bottom: 1px solid var(--line);
  }

  .hero-label {
    margin-bottom: var(--sp-4);
  }

  .hero-name {
    font-weight: 900;
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin-bottom: var(--sp-6);
  }

  .hero-lower {
    max-width: 560px;
  }

  .hero-desc {
    color: var(--ink-2);
    margin-bottom: var(--sp-4);
  }

  .hero-desc a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .hero-links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-2);
    padding: var(--sp-1) 0;
  }

  .hero-links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* ---- Sections ---- */
  .section {
    padding: var(--sp-7) 0;
    border-bottom: 1px solid var(--line);
  }

  .section--compact {
    padding: var(--sp-6) 0;
  }

  .section-head {
    margin-bottom: var(--sp-5);
  }

  .section-head h2 {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .section-lede {
    color: var(--ink-3);
    font-size: var(--text-sm);
    margin-top: var(--sp-1);
  }

  /* Anchor for ring.js "All N" links; sits at the section top. */
  .anchor {
    display: block;
    position: relative;
    top: calc(-1 * var(--sp-7));
  }

  /* ---- Live directory: index rows with hairlines and a chevron ---- */
  .dir {
    border-top: 1px solid var(--line);
  }

  .dir-row {
    display: grid;
    grid-template-columns: 72px 28px minmax(0, 1fr) auto 20px;
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-4) var(--sp-2);
    border-bottom: 1px solid var(--line);
    color: inherit;
    transition: background var(--dur-1) var(--ease);
  }

  a.dir-row:hover {
    background: var(--surface);
    text-decoration: none;
  }

  /* In the ring but not deployed yet: visibly a different thing, not a link. */
  .dir-row--soon .dir-name,
  .dir-row--soon .dir-blurb {
    color: var(--ink-3);
  }

  .dir-cat {
    color: var(--accent);
  }

  .dir-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dir-name {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: var(--track-head);
  }

  .dir-row:hover .dir-name {
    color: var(--accent);
  }

  .dir-blurb {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .dir-host {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .dir-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    align-self: center;
    /* someday.png has a white plate; a hairline keeps it from floating on dark */
    border: 1px solid var(--line);
    background: var(--surface);
    object-fit: cover;
  }

  .dir-chev {
    color: var(--ink-3);
    font-size: var(--text-lg);
    line-height: 1;
    transition: transform var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }

  .dir-row:hover .dir-chev {
    color: var(--accent);
    transform: translateX(3px);
  }

  /* ---- Experience ---- */
  .exp-block {
    padding-bottom: var(--sp-6);
  }

  .exp-block--later {
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
  }

  .exp-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-5);
    margin-bottom: var(--sp-4);
  }

  .exp-role {
    display: block;
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .exp-company {
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  .exp-note {
    color: var(--ink-3);
  }

  .exp-period {
    white-space: nowrap;
    padding-top: var(--sp-1);
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }

  .exp-bullets li {
    position: relative;
    padding-left: var(--sp-5);
    margin-bottom: var(--sp-2);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  /* Accent hairline as the bullet marker. */
  .exp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }

  /* ---- Projects: one card, two sizes ---- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }

  .card-icon {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    flex-shrink: 0;
  }

  .card-gh {
    margin-left: auto;
    color: var(--ink-3);
    transition: color var(--dur-1) var(--ease);
  }

  .card:hover .card-gh {
    color: var(--accent);
  }

  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    transition: border-color var(--dur-1) var(--ease);
  }

  /* ponytail: stretched-link. The name anchor's ::after covers the whole card,
     so clicking anywhere on a linked card opens it. No nested anchors, and
     keyboard focus still lands on the one real link. */
  a.card-name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:has(a.card-name) {
    cursor: pointer;
  }

  .card:has(a.card-name):hover {
    border-color: var(--line-2);
  }

  .card:has(a.card-name):hover .card-name {
    color: var(--accent);
  }

  /* Not deployed, not clickable: visibly a different thing. */
  .card--flat {
    background: transparent;
    border-style: dashed;
  }

  .card--flat .card-name {
    color: var(--ink-2);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .card-name {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: var(--track-head);
    color: var(--ink);
  }

  a.card-name:hover {
    text-decoration: none;
  }

  .card-tagline {
    margin-top: calc(-1 * var(--sp-1));
  }

  .card-desc {
    color: var(--ink-2);
    font-size: var(--text-sm);
    flex: 1;
  }

  .card-note {
    font-size: var(--text-xs);
    color: var(--accent);
  }

  /* ---- Badges ---- */
  .badge {
    padding: 2px var(--sp-2);
    border: 1px solid var(--line-2);
    border-radius: var(--r-pill);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge--live {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ---- Tags ---- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    margin-top: auto;
    padding-top: var(--sp-1);
  }

  .tag {
    background: var(--accent-subtle);
    color: var(--ink-2);
    padding: 2px var(--sp-2);
    border-radius: var(--r-sm);
  }

  /* ---- Stack: same index-row language as the directory ---- */
  .stack {
    border-top: 1px solid var(--line);
  }

  .stack-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-3) var(--sp-2);
    border-bottom: 1px solid var(--line);
  }

  .stack-cat {
    color: var(--accent);
  }

  .stack-items {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-2);
  }

  .stack-item {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .skill-sep {
    color: var(--ink-3);
    font-size: var(--text-xs);
    opacity: 0.5;
    user-select: none;
  }

  /* ---- Blog ---- */
  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    color: inherit;
  }

  .post-row:first-child {
    border-top: 1px solid var(--line);
  }

  .post-row:hover {
    text-decoration: none;
  }

  .post-row:hover .post-title {
    color: var(--accent);
  }

  .post-title {
    font-size: var(--text-md);
    font-weight: 500;
    transition: color var(--dur-1) var(--ease);
  }

  .post-line {
    flex: 1;
    height: 1px;
    background: var(--line);
    min-width: var(--sp-6);
  }

  .post-row time {
    white-space: nowrap;
  }

  .link-subtle {
    display: inline-block;
    margin-top: var(--sp-4);
    color: var(--ink-2);
  }

  .link-subtle:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* ---- Contact ---- */
  .section--contact {
    padding: var(--sp-8) 0;
    border-bottom: none;
  }

  .contact-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: var(--track-head);
    margin-bottom: var(--sp-2);
  }

  .contact-desc {
    color: var(--ink-2);
    font-size: var(--text-sm);
    margin-bottom: var(--sp-4);
    max-width: 480px;
  }

  .contact-link {
    font-family: var(--font-mono);
