---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const experience = {
  company: 'GeoIQ',
  companyNote: 'a Lenskart company',
  url: 'https://geoiq.io',
  period: 'Jan 2025 - Present',
  roles: [
    { role: 'Software Development Engineer', period: 'Jun 2025 - Present' },
    { role: 'Software Development Engineer Intern', period: 'Jan 2025 - Jun 2025' },
  ],
  groups: [
    {
      name: 'AI and developer systems',
      highlights: [
        'Rebuilt Lenskart\'s WhatsApp analytics assistant on Gemini, moved access checks server-side, and closed a production data leak.',
        'Built an evaluation suite that supported a cheaper Gemini model, cutting daily spend by about 88% and making responses about 3x faster.',
        'Built an RCA agent that reproduces issues in isolated worktrees and traces production data, logs, and code, reducing resolution time from days to hours.',
      ],
    },
    {
      name: 'Data and product platforms',
      highlights: [
        'Replaced record-level Airbyte syncs with Parquet and streamed COPY in BigQuery-to-Postgres Airflow pipelines, cutting full-mart refresh time by 94-96%.',
        'Built self-serve payments, invoicing, subscription contracts, and expiry workflows with Razorpay, Zoho Books, and verified idempotent webhooks.',
        'Designed conditional caching for report sections, reducing report-generation latency by 80%+.',
      ],
    },
    {
      name: 'Automation and operations',
      highlights: [
        'Own the pipeline that turns field surveys and geospatial data into client-ready presentations in 30 seconds to 5 minutes.',
        'Architected real-time messaging used across three production applications with WebSockets and Pub/Sub.',
        'Built Slack administration, customer notification, and telephony systems with approvals, delivery tracking, idempotent call-state webhooks, and shared summaries.',
      ],
    },
  ],
};

// The work to lead with. The #tools anchor stays here because ring.js sends
// its "All N" link to this part of the homepage.
const featuredWork = [
  {
    name: 'Switchboard',
    host: 'switchboard.tn07.dev',
    icon: '/icons/switchboard.png',
    blurb: 'One workspace for coding agents, terminals, files, and git worktrees, on your machine or over SSH.',
  },
  {
    name: 'Someday',
    host: 'someday.tn07.dev',
    icon: '/icons/someday.png',
    blurb: 'Save the things you want to do together, then actually make them happen.',
  },
  {
    name: 'Scout',
    host: 'scout.tn07.dev',
    icon: '/icons/scout.svg',
    blurb: 'Jobs scored against your profile, so the strongest matches rise first.',
  },
  {
    name: 'WatchWithMi',
    host: 'watchwithmi.tn07.dev',
    icon: '/icons/watchwithmi.svg',
    blurb: 'Watch together from different places with synchronized playback, rooms, and chat.',
  },
];

const funSites = [
  { name: 'Follymarket', host: 'follymarket.tn07.dev', icon: '/icons/follymarket.svg', blurb: 'Play-money prediction markets.' },
  { name: 'Board Games', host: 'gaming.tn07.dev', icon: '/icons/gaming.svg', blurb: 'Battleship, Connect 4, and Labyrinth in the browser.' },
  { name: 'Marvel Syllabus', host: 'marvel.tn07.dev', icon: '/icons/marvel.svg', blurb: 'A continuity-ordered reading syllabus for 65 years of Marvel comics.' },
];

// Smaller engineering work whose main destination is a repository.
const projects = [
  {
    name: 'macremote',
    icon: '/icons/macremote.png',
    description: 'A self-hosted Android remote for your Mac. Control media, volume, brightness, lock, and sleep over Tailscale.',
    tech: ['React Native', 'FastAPI', 'Hammerspoon'],
    link: 'https://github.com/tejasnafde/macremote',
  },
  {
    name: 'FZM Server Manager',
    description: 'Production bot for Factorio multiplayer servers. WebSocket real-time updates, REST lifecycle control, dual-layer state persistence.',
    tech: ['Python', 'WebSockets', 'SQLite', 'Docker'],
    link: 'https://github.com/tejasnafde/fzm-discord-bot',
  },
  {
    name: 'bbpr',
    description: 'Fetches Bitbucket Cloud pull requests in a shape AI agents can review. Install once, point any agent at a PR.',
    tech: ['Python', 'Bitbucket API'],
    link: 'https://github.com/tejasnafde/bbpr',
  },
  {
    name: 'tejas-skills',
    description: 'Personal skill library for AI coding agents. One format that works across Claude Code, Cursor, and friends.',
    tech: ['Markdown', 'Agent Skills'],
    link: 'https://github.com/tejasnafde/tejas-skills',
  },
  {
    name: 'learnlang',
    description: 'A personalized voice tutor. It adapts its curriculum from your conversations, remembered mistakes, and spaced repetition.',
    tech: ['Python', 'Vertex AI', 'Speech'],
    link: null,
    status: 'coming-soon',
  },
  {
    name: 'Unetsim-Routing',
    description: 'Multi-layered underwater sensor network and routing protocol built on UnetStack.',
    note: 'Research project under Prof. Sarang C. Dhongdi, BITS Pilani Goa',
    noteUrl: 'https://www.bits-pilani.ac.in/goa/sarang-chandrashekhar-dhongdi/',
    tech: ['Java', 'Groovy', 'UnetStack'],
    link: 'https://github.com/tejasnafde/Unetsim-Routing',
  },
  {
    name: 'MyOptum',
    description: 'Hardware communication layer for a remote phoropter. Real-time serial comms with a custom binary protocol (SOH/CR/EOT).',
    note: 'Lenskart Hackathon - Special Mention',
    tech: ['Python', 'Serial Protocol'],
    link: null,
    status: 'private',
  },
];

const stack = [
  { group: 'Languages', items: ['Python', 'TypeScript', 'SQL'] },
  { group: 'Backend', items: ['FastAPI', 'Flask', 'Node.js', 'WebSockets'] },
  { group: 'Data', items: ['PostgreSQL/PostGIS', 'BigQuery', 'MongoDB', 'Redis', 'SQLite'] },
  { group: 'Infrastructure', items: ['GCP', 'Cloud Run', 'Pub/Sub', 'Airflow', 'Docker', 'Linux'] },
  { group: 'AI', items: ['Gemini', 'Vertex AI'] },
];

---

<BaseLayout title="Tejas Nafde - Software Engineer" personSchema>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-label label">Software Engineer / Bengaluru</div>
      <h1 class="hero-name">Tejas Nafde</h1>
      <div class="hero-lower">
        <p class="hero-desc">
          I build backend systems, real-time infrastructure, and developer tools.
          Currently at <a href="https://geoiq.io" target="_blank" rel="noopener">GeoIQ</a>, a Lenskart company.
          BITS Pilani Goa alumnus.
        </p>
        <div class="hero-links">
          <a href="#projects">selected work</a>
          <a href="https://github.com/tejasnafde" target="_blank" rel="noopener">github</a>
          <a href="https://www.linkedin.com/in/tejas-nafde/" target="_blank" rel="noopener">linkedin</a>
          <a href="mailto:nafdetejas@gmail.com">email</a>
          <a href="https://drive.google.com/file/d/1sYJAv4TOsi_pFA71pgHXbWaDUbcmbjKA/view?usp=sharing" target="_blank" rel="noopener">resume</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="section">
    <div class="wrap">
      <span id="tools" class="anchor" aria-hidden="true"></span>
      <div class="section-head">
        <h2>Projects</h2>
        <p class="section-lede">Products you can use, followed by smaller engineering work.</p>
      </div>
      <div class="project-group">
        <div class="group-head">
          <h3>Featured work</h3>
        </div>
        <div class="featured-list">
          {featuredWork.map((p, i) => (
            <a href={`https://${p.host}`} class="featured-row">
              <span class="featured-index label num">{String(i + 1).padStart(2, '0')}</span>
              <img class="featured-icon" src={p.icon} alt="" width="40" height="40" loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="featured-main">
                <b class="featured-name">{p.name}</b>
                <span class="featured-blurb">{p.blurb}</span>
              </span>
              <span class="featured-host">{p.host}</span>
              <span class="featured-chev" aria-hidden="true">&rsaquo;</span>
            </a>
          ))}
        </div>
      </div>
      <div class="project-group">
        <div class="group-head">
          <h3>More engineering work</h3>
        </div>
        <div class="card-grid">
          {projects.map((p) => (
            <div class={`card ${p.link ? '' : 'card--flat'}`}>
              <div class="card-top">
                {p.icon && <img class="card-icon" src={p.icon} alt="" width="22" height="22" loading="lazy" />}
                {p.link ? (
                  <a href={p.link} target="_blank" rel="noopener" class="card-name">{p.name}</a>
                ) : (
                  <span class="card-name">{p.name}</span>
                )}
                {p.link && <span class="card-gh label">github &rsaquo;</span>}
                {p.status && <span class={`badge label badge--${p.status}`}>{p.status}</span>}
              </div>
              <p class="card-desc">{p.description}</p>
              {p.note && (p.noteUrl ? (
                <a href={p.noteUrl} target="_blank" rel="noopener" class="card-note">{p.note}</a>
              ) : (
                <p class="card-note">{p.note}</p>
              ))}
              <div class="tags">
                {p.tech.map((t) => (
                  <span class="tag label">{t}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="work" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
      </div>
      <div class="experience">
        <div class="experience-head">
          <div>
            <a href={experience.url} target="_blank" rel="noopener" class="experience-company">
              {experience.company}
            </a>
            <span class="experience-note">{experience.companyNote}</span>
          </div>
          <span class="experience-period label num">{experience.period}</span>
        </div>
        <div class="role-timeline">
          {experience.roles.map((role, i) => (
            <div class="role-step">
              <span class="role-index label num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <span class="role-name">{role.role}</span>
                <span class="role-period label num">{role.period}</span>
              </div>
            </div>
          ))}
        </div>
        <div class="impact-grid">
          {experience.groups.map((group) => (
            <div class="impact-group">
              <h3 class="impact-label label">{group.name}</h3>
              <ul class="impact-list">
                {group.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class="section section--compact">
    <div class="wrap">
      <div class="section-head">
        <h2>Tools &amp; Stack</h2>
      </div>
      <div class="stack">
        {stack.map((row) => (
          <div class="stack-row">
            <span class="stack-cat label">{row.group}</span>
            <span class="stack-items">
              {row.items.map((it, i) => (
                <Fragment>
                  <span class="stack-item">{it}</span>
                  {i < row.items.length - 1 && <span class="skill-sep" aria-hidden="true">/</span>}
                </Fragment>
              ))}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Posts -->
  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>Writing</h2>
        </div>
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="post-row">
              <span class="post-title">{post.data.title}</span>
              <span class="post-line"></span>
              <time class="label num" datetime={post.data.date}>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}</time>
            </a>
          ))}
        </div>
        <a href="/blog" class="link-subtle label">all posts &rarr;</a>
      </div>
    </section>
  )}

  <!-- For fun -->
  <section id="fun" class="section section--compact">
    <div class="wrap">
      <div class="section-head">
        <h2>For fun</h2>
        <p class="section-lede">Small sites built for friends, games, and curiosity.</p>
      </div>
      <div class="fun-list">
        {funSites.map((site) => (
          <a href={`https://${site.host}`} class="fun-row">
            <img class="fun-icon" src={site.icon} alt="" width="28" height="28" loading="lazy" />
            <span class="fun-main">
              <b class="fun-name">{site.name}</b>
              <span class="fun-blurb">{site.blurb}</span>
            </span>
            <span class="fun-host">{site.host}</span>
            <span class="fun-chev" aria-hidden="true">&rsaquo;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section section--contact">
    <div class="wrap">
      <h2 class="contact-title">Let's talk.</h2>
      <p class="contact-desc">Have an interesting engineering problem, a useful product idea, or a role with real ownership? Send me a note.</p>
      <a href="mailto:nafdetejas@gmail.com" class="contact-link">nafdetejas@gmail.com &rarr;</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  /* ---- Hero ---- */
  .hero {
    padding: calc(var(--sp-8) + var(--sp-7)) 0 var(--sp-7);
    border-bottom: 1px solid var(--line);
  }

  .hero-label {
    margin-bottom: var(--sp-4);
  }

  .hero-name {
    font-weight: 900;
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin-bottom: var(--sp-6);
  }

  .hero-lower {
    max-width: 560px;
  }

  .hero-desc {
    color: var(--ink-2);
    margin-bottom: var(--sp-4);
  }

  .hero-desc a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .hero-links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-2);
    padding: var(--sp-1) 0;
  }

  .hero-links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* ---- Sections ---- */
  .section {
    padding: var(--sp-7) 0;
    border-bottom: 1px solid var(--line);
  }

  .section--compact {
    padding: var(--sp-6) 0;
  }

  .section-head {
    margin-bottom: var(--sp-5);
  }

  .section-head h2 {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .section-lede {
    color: var(--ink-3);
    font-size: var(--text-sm);
    margin-top: var(--sp-1);
  }

  /* Anchor for ring.js "All N" links; sits at the section top. */
  .anchor {
    display: block;
    position: relative;
    top: calc(-1 * var(--sp-7));
  }

  /* ---- Featured work: large index rows ---- */
  .project-group + .project-group {
    margin-top: var(--sp-7);
  }

  .group-head {
    margin-bottom: var(--sp-3);
  }

  .group-head h3 {
    font-size: var(--text-md);
    font-weight: 650;
  }

  .featured-list,
  .fun-list {
    border-top: 1px solid var(--line);
  }

  .featured-row {
    display: grid;
    grid-template-columns: 36px 40px minmax(0, 1fr) auto 20px;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-5) var(--sp-2);
    border-bottom: 1px solid var(--line);
    color: inherit;
    transition: background var(--dur-1) var(--ease);
  }

  .featured-row:hover,
  .fun-row:hover {
    background: var(--surface);
    text-decoration: none;
  }

  .featured-index {
    color: var(--accent);
  }

  .featured-main,
  .fun-main {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .featured-name {
    font-weight: 750;
    font-size: var(--text-xl);
    letter-spacing: var(--track-head);
  }

  .featured-row:hover .featured-name,
  .fun-row:hover .fun-name {
    color: var(--accent);
  }

  .featured-blurb,
  .fun-blurb {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .featured-host,
  .fun-host {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .featured-icon,
  .fun-icon {
    border: 1px solid var(--line);
    background: var(--surface);
    object-fit: cover;
  }

  .featured-icon {
    width: 40px;
    height: 40px;
    border-radius: 9px;
  }

  .featured-chev,
  .fun-chev {
    color: var(--ink-3);
    font-size: var(--text-lg);
    line-height: 1;
    transition: transform var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }

  .featured-row:hover .featured-chev,
  .fun-row:hover .fun-chev {
    color: var(--accent);
    transform: translateX(3px);
  }

  /* ---- Fun: a smaller directory near the end of the page ---- */
  .fun-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto 20px;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-3) var(--sp-2);
    border-bottom: 1px solid var(--line);
    color: inherit;
    transition: background var(--dur-1) var(--ease);
  }

  .fun-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
  }

  .fun-main {
    flex-direction: row;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .fun-name {
    min-width: 132px;
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: var(--track-head);
  }

  /* ---- Experience ---- */
  .experience-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-5);
    margin-bottom: var(--sp-4);
  }

  .experience-company {
    font-size: var(--text-xl);
    font-weight: 750;
    letter-spacing: var(--track-head);
    color: var(--ink);
  }

  .experience-company:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .experience-note {
    margin-left: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .experience-period,
  .role-period {
    color: var(--ink-3);
  }

  .experience-period {
    white-space: nowrap;
  }

  .role-timeline {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .role-step {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-3);
  }

  .role-step + .role-step {
    border-left: 1px solid var(--line);
  }

  .role-index {
    color: var(--accent);
    padding-top: 2px;
  }

  .role-name,
  .role-period {
    display: block;
  }

  .role-name {
    font-size: var(--text-md);
    font-weight: 650;
  }

  .role-period {
    margin-top: 2px;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--sp-6);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .impact-group {
    padding: var(--sp-5) var(--sp-4);
  }

  .impact-group + .impact-group {
    border-left: 1px solid var(--line);
  }

  .impact-label {
    color: var(--accent);
    margin-bottom: var(--sp-4);
  }

  .impact-list {
    list-style: none;
    padding: 0;
  }

  .impact-list li {
    position: relative;
    padding-left: var(--sp-5);
    margin-bottom: var(--sp-4);
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .impact-list li:last-child {
    margin-bottom: 0;
  }

  .impact-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }

  /* ---- More engineering work ---- */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .card-icon {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    flex-shrink: 0;
  }

  .card-gh {
    margin-left: auto;
    color: var(--ink-3);
    transition: color var(--dur-1) var(--ease);
  }

  .card:hover .card-gh {
    color: var(--accent);
  }

  .card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    transition: border-color var(--dur-1) var(--ease);
  }

  /* ponytail: stretched-link. The name anchor's ::after covers the whole card,
     so clicking anywhere on a linked card opens it. No nested anchors, and
     keyboard focus still lands on the one real link. */
  a.card-name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:has(a.card-name) {
    cursor: pointer;
  }

  .card:has(a.card-name):hover {
    border-color: var(--line-2);
  }

  .card:has(a.card-name):hover .card-name {
    color: var(--accent);
  }

  /* Not deployed, not clickable: visibly a different thing. */
  .card--flat {
    background: transparent;
    border-style: dashed;
  }

  .card--flat .card-name {
    color: var(--ink-2);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .card-name {
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: var(--track-head);
    color: var(--ink);
  }

  a.card-name:hover {
    text-decoration: none;
  }

  .card-tagline {
    margin-top: calc(-1 * var(--sp-1));
  }

  .card-desc {
    color: var(--ink-2);
